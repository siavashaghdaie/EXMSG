generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ORGANIZATION & USER MODELS
// ============================================

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  avatarUrl   String?  @map("avatar_url")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members  OrganizationMember[]
  channels Channel[]

  @@map("organizations")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String    @unique
  displayName  String    @map("display_name")
  passwordHash String    @map("password_hash")
  avatarUrl    String?   @map("avatar_url")
  bio          String?
  status       String?   @default("Hey, I'm using Exclusive Messenger!")
  isOnline     Boolean   @default(false) @map("is_online")
  lastSeenAt   DateTime? @map("last_seen_at")
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")
  twoFactorSecret  String? @map("two_factor_secret")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  organizations    OrganizationMember[]
  sentMessages     Message[]            @relation("SentMessages")
  conversationMembers ConversationMember[]
  reactions        MessageReaction[]
  readReceipts     ReadReceipt[]
  refreshTokens    RefreshToken[]
  tasksAssigned    Task[]               @relation("TasksAssigned")
  tasksCreated     Task[]               @relation("TasksCreated")
  tasksOrdered     Task[]               @relation("TasksOrdered")
  lindaConversations LindaConversation[]
  lindaRelated       LindaConversationRelatedUser[]
  userStatuses     UserStatus[]
  statusViews      StatusView[]         @relation("StatusViews")
  statusLikes      StatusLike[]         @relation("StatusLikes")
  announcements    Announcement[]
  announcementReads AnnouncementRead[]
  lindaActivitiesOrdered LindaActivity[] @relation("LindaActivitiesOrdered")
  lindaActivitiesTarget  LindaActivity[] @relation("LindaActivitiesTarget")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  role           OrgRole  @default(MEMBER)
  joinedAt       DateTime @default(now()) @map("joined_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

// ============================================
// CONVERSATION & CHANNEL MODELS
// ============================================

model Conversation {
  id          String           @id @default(uuid())
  type        ConversationType
  name        String?
  description String?
  avatarUrl   String?          @map("avatar_url")
  isArchived  Boolean          @default(false) @map("is_archived")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  members  ConversationMember[]
  messages Message[]
  pins     PinnedMessage[]

  @@map("conversations")
}

enum ConversationType {
  DIRECT
  GROUP
  CHANNEL
}

model ConversationMember {
  id             String         @id @default(uuid())
  conversationId String         @map("conversation_id")
  userId         String         @map("user_id")
  role           ConvRole       @default(MEMBER)
  isMuted        Boolean        @default(false) @map("is_muted")
  joinedAt       DateTime       @default(now()) @map("joined_at")
  lastReadAt     DateTime?      @map("last_read_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_members")
}

enum ConvRole {
  OWNER
  ADMIN
  MEMBER
}

model Channel {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  conversationId String?  @unique @map("conversation_id")
  slug           String
  isPublic       Boolean  @default(true) @map("is_public")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@map("channels")
}

// ============================================
// MESSAGE MODELS
// ============================================

model Message {
  id             String      @id @default(uuid())
  conversationId String      @map("conversation_id")
  senderId       String      @map("sender_id")
  replyToId      String?     @map("reply_to_id")
  content        String?
  type           MessageType @default(TEXT)
  isEdited       Boolean     @default(false) @map("is_edited")
  isDeleted      Boolean     @default(false) @map("is_deleted")
  scheduledAt    DateTime?   @map("scheduled_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User              @relation("SentMessages", fields: [senderId], references: [id])
  replyTo      Message?          @relation("Replies", fields: [replyToId], references: [id])
  replies      Message[]         @relation("Replies")
  attachments  MessageAttachment[]
  reactions    MessageReaction[]
  readReceipts ReadReceipt[]
  pins         PinnedMessage[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  VOICE
  VIDEO
  SYSTEM
  POLL
  STORY_REPLY
}

model MessageAttachment {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  fileName  String   @map("file_name")
  fileSize  Int      @map("file_size")
  mimeType  String   @map("mime_type")
  url       String
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_attachments")
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@map("message_reactions")
}

model ReadReceipt {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  readAt    DateTime @default(now()) @map("read_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("read_receipts")
}

model PinnedMessage {
  id             String   @id @default(uuid())
  messageId      String   @map("message_id")
  conversationId String   @map("conversation_id")
  pinnedAt       DateTime @default(now()) @map("pinned_at")

  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([messageId, conversationId])
  @@map("pinned_messages")
}

// ============================================
// TASK MODELS
// ============================================

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, PENDING_REVIEW, COMPLETED, BLOCKED
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  deadline    DateTime?
  labels      String[] @default([])

  assignedToId String
  assignedTo   User     @relation("TasksAssigned", fields: [assignedToId], references: [id])

  createdById  String
  createdBy    User     @relation("TasksCreated", fields: [createdById], references: [id])

  orderedById  String?  @map("ordered_by_id")
  orderedBy    User?    @relation("TasksOrdered", fields: [orderedById], references: [id])

  sourceMessageId String?

  lindaFollowing       Boolean  @default(false) @map("linda_following")
  lindaFollowInterval  String?  @map("linda_follow_interval") // e.g. "daily", "every_2_days", "weekly"

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([assignedToId])
  @@index([createdById])
  @@index([status])
  @@map("tasks")
}

// ============================================
// LINDA AI CONVERSATION MODELS
// ============================================

model LindaConversation {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     LindaMessage[]
  relatedUsers LindaConversationRelatedUser[]

  @@index([userId])
  @@map("linda_conversations")
}

model LindaMessage {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  role           String   // 'user' or 'assistant'
  content        String
  hasAttachment  Boolean  @default(false) @map("has_attachment")
  attachmentName String?  @map("attachment_name")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation LindaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("linda_messages")
}

model LindaConversationRelatedUser {
  id             String @id @default(uuid())
  conversationId String @map("conversation_id")
  userId         String @map("user_id")

  conversation LindaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("linda_conversation_related_users")
}

// ============================================
// USER STATUS/STORIES MODELS
// ============================================

model UserStatus {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String   // 'text', 'image', 'video'
  content   String   // text content or file URL
  bgColor   String?  @map("bg_color") // background color for text statuses
  caption   String?
  expiresAt DateTime @map("expires_at") // 24h from creation
  createdAt DateTime @default(now()) @map("created_at")

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  views StatusView[]
  likes StatusLike[]

  @@index([userId, expiresAt])
  @@map("user_statuses")
}

model StatusView {
  id        String   @id @default(uuid())
  statusId  String   @map("status_id")
  viewerId  String   @map("viewer_id")
  viewedAt  DateTime @default(now()) @map("viewed_at")

  status UserStatus @relation(fields: [statusId], references: [id], onDelete: Cascade)
  viewer User       @relation("StatusViews", fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([statusId, viewerId])
  @@map("status_views")
}

model StatusLike {
  id        String   @id @default(uuid())
  statusId  String   @map("status_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  status UserStatus @relation(fields: [statusId], references: [id], onDelete: Cascade)
  user   User       @relation("StatusLikes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([statusId, userId])
  @@map("status_likes")
}

// ============================================
// ANNOUNCEMENTS MODEL
// ============================================

model Announcement {
  id        String   @id @default(uuid())
  authorId  String   @map("author_id")
  title     String
  content   String
  priority  String   @default("NORMAL") // 'LOW', 'NORMAL', 'HIGH', 'URGENT'
  pinned    Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reads  AnnouncementRead[]

  @@index([createdAt])
  @@map("announcements")
}

model AnnouncementRead {
  id             String   @id @default(uuid())
  announcementId String   @map("announcement_id")
  userId         String   @map("user_id")
  noted          Boolean  @default(false)
  readAt         DateTime @default(now()) @map("read_at")
  notedAt        DateTime? @map("noted_at")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
  @@map("announcement_reads")
}

// ============================================
// LINDA ACTIVITY LOG
// ============================================

model LindaActivity {
  id             String   @id @default(uuid())
  orderedById    String   @map("ordered_by_id")
  actionType     String   @map("action_type")       // 'send_message', 'assign_task', 'create_announcement', 'update_task'
  targetUserId   String?  @map("target_user_id")
  status         String   @default("completed")      // 'completed', 'failed'
  summary        String                               // Human-readable summary
  details        String?                              // JSON with action-specific data
  createdAt      DateTime @default(now()) @map("created_at")

  orderedBy  User  @relation("LindaActivitiesOrdered", fields: [orderedById], references: [id], onDelete: Cascade)
  targetUser User? @relation("LindaActivitiesTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([orderedById, createdAt])
  @@index([targetUserId])
  @@map("linda_activities")
}

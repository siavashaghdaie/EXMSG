generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ORGANIZATION & USER MODELS
// ============================================

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  avatarUrl   String?  @map("avatar_url")   // Also serves as the company logo
  description String?
  // "public" panels appear on the landing page and can be found by other panel owners.
  // "private" panels are hidden from discovery.
  visibility  String   @default("private")   // "public" | "private"
  // Subscription plan selected at signup time
  plan        String   @default("starter")
  planStatus  String   @default("active") @map("plan_status")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members      OrganizationMember[]
  departments  Department[]
  projects     Project[]
  channels     Channel[]
  inviteTokens InviteToken[]
  conversations Conversation[]
  tasks        Task[]
  announcements Announcement[]
  sentPanelRequests     InterPanelRequest[] @relation("SentPanelRequests")
  receivedPanelRequests InterPanelRequest[] @relation("ReceivedPanelRequests")
  orgAgents             OrgAgent[]

  @@map("organizations")
}

// Completely separate table for platform super admins.
// Super admins manage the back-office (orgs, users, billing) and are NOT
// regular messenger users.  Their email can overlap with a regular User
// without conflict.
model SuperAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  displayName  String   @map("display_name")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("super_admins")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String    @unique
  displayName  String    @map("display_name")
  passwordHash String    @map("password_hash")
  avatarUrl    String?   @map("avatar_url")
  bio          String?
  status       String?   @default("Hey, I'm using Exclusive Messenger!")
  isOnline     Boolean   @default(false) @map("is_online")
  lastSeenAt   DateTime? @map("last_seen_at")
  emailVerified    Boolean   @default(false) @map("email_verified")
  role             String    @default("USER") // "USER", "ORG_ADMIN"  (SUPER_ADMIN is in its own table now)
  superAdminHash   String?  @map("super_admin_hash") // Deprecated — kept for backward compat
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")
  twoFactorSecret  String? @map("two_factor_secret")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  organizations    OrganizationMember[]
  sentMessages     Message[]            @relation("SentMessages")
  conversationMembers ConversationMember[]
  reactions        MessageReaction[]
  readReceipts     ReadReceipt[]
  refreshTokens    RefreshToken[]
  tasksAssigned    Task[]               @relation("TasksAssigned")
  tasksCreated     Task[]               @relation("TasksCreated")
  tasksOrdered     Task[]               @relation("TasksOrdered")
  tasksDeleted     Task[]               @relation("TasksDeleted")
  lindaConversations LindaConversation[]
  lindaRelated       LindaConversationRelatedUser[]
  userStatuses     UserStatus[]
  statusViews      StatusView[]         @relation("StatusViews")
  statusLikes      StatusLike[]         @relation("StatusLikes")
  announcements    Announcement[]
  announcementReads AnnouncementRead[]
  announcementReactions AnnouncementReaction[]
  announcementComments  AnnouncementComment[]
  taskReactions    TaskReaction[]
  taskComments     TaskComment[]
  lindaActivitiesOrdered LindaActivity[] @relation("LindaActivitiesOrdered")
  lindaActivitiesTarget  LindaActivity[] @relation("LindaActivitiesTarget")
  lindaMemories      LindaMemory[]
  otpCodes           OtpCode[]
  sentInvites        InviteToken[]    @relation("InvitedByUser")
  departmentMembers  DepartmentMember[]
  projectMembers     ProjectMember[]
  projectsCreated    Project[]        @relation("ProjectsCreated")
  projectsLead       Project[]        @relation("ProjectTeamLead")
  taskAttachments    TaskAttachment[] @relation("TaskAttachmentUploads")
  callsMade          Call[]           @relation("CallsMade")
  callsReceived      Call[]           @relation("CallsReceived")
  starredMessages    StarredMessage[]
  blockedByMe        BlockedUser[]    @relation("BlockedByMe")
  blockedMe          BlockedUser[]    @relation("BlockedMe")
  reportsMade        ReportedUser[]   @relation("ReportsMade")
  reportsReceived    ReportedUser[]   @relation("ReportsReceived")
  pushSubscriptions  PushSubscription[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  role           OrgRole  @default(MEMBER)
  joinedAt       DateTime @default(now()) @map("joined_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

// ============================================
// CONVERSATION & CHANNEL MODELS
// ============================================

model Conversation {
  id             String           @id @default(uuid())
  organizationId String?          @map("organization_id") // null for inter-panel owner DMs
  type           ConversationType
  name           String?
  description    String?
  avatarUrl      String?          @map("avatar_url")
  isArchived     Boolean          @default(false) @map("is_archived")
  // When true, this is a cross-panel DM between two org owners
  isInterPanel   Boolean          @default(false) @map("is_inter_panel")
  // Disappearing messages: null = off, otherwise duration in seconds
  disappearingSeconds Int?        @map("disappearing_seconds")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      ConversationMember[]
  messages     Message[]
  pins         PinnedMessage[]
  starredMessages StarredMessage[]
  interPanelRequests InterPanelRequest[]
  linkedTask    Task?    @relation("TaskConversation")
  linkedProject Project? @relation("ProjectConversation")
  calls         Call[]

  @@index([organizationId])
  @@map("conversations")
}

enum ConversationType {
  DIRECT
  GROUP
  CHANNEL
}

model ConversationMember {
  id             String         @id @default(uuid())
  conversationId String         @map("conversation_id")
  userId         String         @map("user_id")
  role           ConvRole       @default(MEMBER)
  isMuted        Boolean        @default(false) @map("is_muted")
  muteUntil      DateTime?      @map("mute_until") // null = muted forever when isMuted
  isPinned       Boolean        @default(false) @map("is_pinned")
  isLocked       Boolean        @default(false) @map("is_locked") // Lock chat (hide behind biometrics)
  isFavorite     Boolean        @default(false) @map("is_favorite")
  autoTranslate  Boolean        @default(false) @map("auto_translate")
  translateLang  String?        @map("translate_lang") // Target language for auto-translate
  customNotificationSound String? @map("custom_notification_sound")
  chatWallpaper  String?        @map("chat_wallpaper") // CSS color or image URL
  saveMedia      String         @default("default") @map("save_media") // "default", "always", "never"
  joinedAt       DateTime       @default(now()) @map("joined_at")
  lastReadAt     DateTime?      @map("last_read_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_members")
}

enum ConvRole {
  OWNER
  ADMIN
  MEMBER
}

model Channel {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  conversationId String?  @unique @map("conversation_id")
  slug           String
  isPublic       Boolean  @default(true) @map("is_public")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@map("channels")
}

// ============================================
// MESSAGE MODELS
// ============================================

model Message {
  id             String      @id @default(uuid())
  conversationId String      @map("conversation_id")
  senderId       String      @map("sender_id")
  replyToId      String?     @map("reply_to_id")
  content        String?
  type           MessageType @default(TEXT)
  isEdited       Boolean     @default(false) @map("is_edited")
  isDeleted      Boolean     @default(false) @map("is_deleted")
  scheduledAt    DateTime?   @map("scheduled_at")
  metadata       String?     // JSON for extra data like story reply info
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User              @relation("SentMessages", fields: [senderId], references: [id])
  replyTo      Message?          @relation("Replies", fields: [replyToId], references: [id])
  replies      Message[]         @relation("Replies")
  attachments  MessageAttachment[]
  reactions    MessageReaction[]
  readReceipts ReadReceipt[]
  pins         PinnedMessage[]
  stars        StarredMessage[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  VOICE
  VIDEO
  SYSTEM
  POLL
  STORY_REPLY
}

model MessageAttachment {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  fileName  String   @map("file_name")
  fileSize  Int      @map("file_size")
  mimeType  String   @map("mime_type")
  url       String
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_attachments")
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@map("message_reactions")
}

model ReadReceipt {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  readAt    DateTime @default(now()) @map("read_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("read_receipts")
}

model PinnedMessage {
  id             String   @id @default(uuid())
  messageId      String   @map("message_id")
  conversationId String   @map("conversation_id")
  pinnedAt       DateTime @default(now()) @map("pinned_at")

  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([messageId, conversationId])
  @@map("pinned_messages")
}

model StarredMessage {
  id             String   @id @default(uuid())
  messageId      String   @map("message_id")
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  starredAt      DateTime @default(now()) @map("starred_at")

  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("starred_messages")
}

model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("BlockedByMe", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedMe", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@map("blocked_users")
}

model ReportedUser {
  id         String   @id @default(uuid())
  reporterId String   @map("reporter_id")
  reportedId String   @map("reported_id")
  reason     String
  details    String?
  status     String   @default("pending") // "pending", "reviewed", "resolved"
  createdAt  DateTime @default(now()) @map("created_at")

  reporter User @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)

  @@map("reported_users")
}

// ============================================
// TASK MODELS
// ============================================

model Task {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  title          String
  description    String?
  status         String   @default("NOT_STARTED")
  priority       String   @default("MEDIUM")
  deadline       DateTime?
  labels         String[] @default([])

  assignedToId String
  assignedTo   User     @relation("TasksAssigned", fields: [assignedToId], references: [id])

  coAssigneeIds String[] @default([]) @map("co_assignee_ids")

  createdById  String
  createdBy    User     @relation("TasksCreated", fields: [createdById], references: [id])

  orderedById  String?  @map("ordered_by_id")
  orderedBy    User?    @relation("TasksOrdered", fields: [orderedById], references: [id])

  sourceMessageId String?

  conversationId String? @unique @map("conversation_id")
  conversation   Conversation? @relation("TaskConversation", fields: [conversationId], references: [id], onDelete: SetNull)

  // Department and Project tagging
  departmentId String?  @map("department_id")
  department   Department? @relation("TaskDepartment", fields: [departmentId], references: [id], onDelete: SetNull)

  projectId    String?  @map("project_id")
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  archived     Boolean  @default(false)

  // Soft-delete: task is never truly removed, just marked deleted
  deleted      Boolean   @default(false)
  deletedAt    DateTime? @map("deleted_at")
  deletedById  String?   @map("deleted_by_id")
  deletedBy    User?     @relation("TasksDeleted", fields: [deletedById], references: [id])

  lindaFollowing       Boolean  @default(false) @map("linda_following")
  lindaFollowInterval  String?  @map("linda_follow_interval")

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  visibleToDepartments Department[] @relation("TaskDepartmentVisibility")
  checklists   Checklist[]
  reactions    TaskReaction[]
  comments     TaskComment[]
  attachments  TaskAttachment[]

  @@index([organizationId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([status])
  @@index([departmentId])
  @@index([projectId])
  @@map("tasks")
}

model TaskReaction {
  id       String   @id @default(uuid())
  taskId   String   @map("task_id")
  userId   String   @map("user_id")
  type     String   // 'like' or 'dislike'
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@map("task_reactions")
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_comments")
}

model TaskAttachment {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type      String   // 'link' or 'file'
  name      String
  url       String
  size      Int?     // file size in bytes (null for links)
  mimeType  String?  @map("mime_type")
  uploadedById String @map("uploaded_by_id")
  uploadedBy   User   @relation("TaskAttachmentUploads", fields: [uploadedById], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@index([taskId])
  @@map("task_attachments")
}

// ============================================
// DEPARTMENTS
// ============================================

model Department {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      DepartmentMember[]
  visibleTasks Task[]       @relation("TaskDepartmentVisibility")
  tasks        Task[]       @relation("TaskDepartment")

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("departments")
}

model DepartmentMember {
  id           String   @id @default(uuid())
  departmentId String   @map("department_id")
  userId       String   @map("user_id")
  joinedAt     DateTime @default(now()) @map("joined_at")

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@index([userId])
  @@map("department_members")
}

// ============================================
// PROJECTS
// ============================================

model Project {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  specsAndGoals  String?  @map("specs_and_goals")  // Rich text for specifications, goals, milestones
  gitUrl         String?  @map("git_url")
  storageUrl     String?  @map("storage_url")       // Google Drive, Dropbox, etc.
  avatarUrl      String?  @map("avatar_url")
  status         String   @default("ACTIVE")         // ACTIVE, PAUSED, COMPLETED, ARCHIVED

  teamLeadId     String?  @map("team_lead_id")
  teamLead       User?    @relation("ProjectTeamLead", fields: [teamLeadId], references: [id], onDelete: SetNull)

  createdById    String   @map("created_by_id")
  createdBy      User     @relation("ProjectsCreated", fields: [createdById], references: [id])

  conversationId String? @unique @map("conversation_id")
  conversation   Conversation? @relation("ProjectConversation", fields: [conversationId], references: [id], onDelete: SetNull)

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        ProjectMember[]
  tasks          Task[]
  checklists     Checklist[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([teamLeadId])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  role      String   @default("MEMBER") // LEAD, MEMBER
  joinedAt  DateTime @default(now()) @map("joined_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

// ============================================
// LINDA AI CONVERSATION MODELS
// ============================================

model LindaConversation {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     LindaMessage[]
  relatedUsers LindaConversationRelatedUser[]

  @@index([userId])
  @@map("linda_conversations")
}

model LindaMessage {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  role           String   // 'user' or 'assistant'
  content        String
  hasAttachment  Boolean  @default(false) @map("has_attachment")
  attachmentName String?  @map("attachment_name")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation LindaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("linda_messages")
}

model LindaConversationRelatedUser {
  id             String @id @default(uuid())
  conversationId String @map("conversation_id")
  userId         String @map("user_id")

  conversation LindaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("linda_conversation_related_users")
}

// ============================================
// USER STATUS/STORIES MODELS
// ============================================

model UserStatus {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String   // 'text', 'image', 'video'
  content   String   // text content or file URL
  bgColor   String?  @map("bg_color") // background color for text statuses
  caption   String?
  expiresAt DateTime @map("expires_at") // 24h from creation
  createdAt DateTime @default(now()) @map("created_at")

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  views StatusView[]
  likes StatusLike[]

  @@index([userId, expiresAt])
  @@map("user_statuses")
}

model StatusView {
  id        String   @id @default(uuid())
  statusId  String   @map("status_id")
  viewerId  String   @map("viewer_id")
  viewedAt  DateTime @default(now()) @map("viewed_at")

  status UserStatus @relation(fields: [statusId], references: [id], onDelete: Cascade)
  viewer User       @relation("StatusViews", fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([statusId, viewerId])
  @@map("status_views")
}

model StatusLike {
  id        String   @id @default(uuid())
  statusId  String   @map("status_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  status UserStatus @relation(fields: [statusId], references: [id], onDelete: Cascade)
  user   User       @relation("StatusLikes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([statusId, userId])
  @@map("status_likes")
}

// ============================================
// ANNOUNCEMENTS MODEL
// ============================================

model Announcement {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  authorId       String   @map("author_id")
  title          String
  content        String
  priority       String   @default("NORMAL")
  pinned         Boolean  @default(false)
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reads        AnnouncementRead[]
  reactions    AnnouncementReaction[]
  comments     AnnouncementComment[]

  @@index([organizationId])
  @@index([createdAt])
  @@map("announcements")
}

model AnnouncementRead {
  id             String   @id @default(uuid())
  announcementId String   @map("announcement_id")
  userId         String   @map("user_id")
  noted          Boolean  @default(false)
  readAt         DateTime @default(now()) @map("read_at")
  notedAt        DateTime? @map("noted_at")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
  @@map("announcement_reads")
}

model AnnouncementReaction {
  id             String   @id @default(uuid())
  announcementId String   @map("announcement_id")
  userId         String   @map("user_id")
  type           String   // 'like' or 'dislike'
  createdAt      DateTime @default(now()) @map("created_at")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([announcementId])
  @@map("announcement_reactions")
}

model AnnouncementComment {
  id             String   @id @default(uuid())
  announcementId String   @map("announcement_id")
  userId         String   @map("user_id")
  content        String
  createdAt      DateTime @default(now()) @map("created_at")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([announcementId, createdAt])
  @@map("announcement_comments")
}

// ============================================
// LINDA ACTIVITY LOG
// ============================================

model LindaActivity {
  id             String   @id @default(uuid())
  orderedById    String   @map("ordered_by_id")
  actionType     String   @map("action_type")       // 'send_message', 'assign_task', 'create_announcement', 'update_task'
  targetUserId   String?  @map("target_user_id")
  status         String   @default("completed")      // 'completed', 'failed'
  summary        String                               // Human-readable summary
  details        String?                              // JSON with action-specific data
  createdAt      DateTime @default(now()) @map("created_at")

  orderedBy  User  @relation("LindaActivitiesOrdered", fields: [orderedById], references: [id], onDelete: Cascade)
  targetUser User? @relation("LindaActivitiesTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([orderedById, createdAt])
  @@index([targetUserId])
  @@map("linda_activities")
}

model LindaMemory {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  category  String   @default("general")   // 'preference', 'fact', 'project', 'relationship', 'general'
  content   String                          // The memory text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
  @@map("linda_memories")
}

// ============================================
// INVITATION TOKENS
// ============================================

model InviteToken {
  id             String   @id @default(uuid())
  token          String   @unique // crypto-random URL-safe token
  email          String // invitee email address
  organizationId String   @map("organization_id")
  role           String   @default("MEMBER") // org role: OWNER, ADMIN, MEMBER
  invitedById    String   @map("invited_by_id") // admin who sent the invite
  displayName    String?  @map("display_name") // optional pre-set display name
  usedAt         DateTime? @map("used_at") // null until the invitee clicks the link
  expiresAt      DateTime @map("expires_at") // 72 hours from creation
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedByUser", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([email])
  @@map("invite_tokens")
}

// ============================================
// OTP / EMAIL VERIFICATION
// ============================================

model OtpCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  purpose   String   // 'register', 'login', 'reset'
  userId    String?  @map("user_id")
  attempts  Int      @default(0) // brute-force protection
  verified  Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@index([code, email])
  @@map("otp_codes")
}

// ============================================
// CHECKLISTS (Trello-style)
// ============================================

model Checklist {
  id        String   @id @default(uuid())
  taskId    String?  @map("task_id")
  projectId String?  @map("project_id")
  title     String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task    Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   ChecklistItem[]

  @@index([taskId])
  @@index([projectId])
  @@map("checklists")
}

model ChecklistItem {
  id          String    @id @default(uuid())
  checklistId String    @map("checklist_id")
  title       String
  completed   Boolean   @default(false)
  position    Int       @default(0)
  assigneeIds String[]  @default([]) @map("assignee_ids")
  dueDate     DateTime? @map("due_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
  @@map("checklist_items")
}

// ============================================
// INTER-PANEL COMMUNICATION
// ============================================

/// A request from one panel (organization) to communicate with another panel.
/// Until accepted, the requesting panel owner only sees the target company name.
/// Once accepted, a DM conversation is created between the two panel owners.
model InterPanelRequest {
  id              String   @id @default(uuid())
  senderOrgId     String   @map("sender_org_id")
  receiverOrgId   String   @map("receiver_org_id")
  status          String   @default("PENDING") // "PENDING" | "ACCEPTED" | "REJECTED"
  message         String?  // Optional message from the sender
  conversationId  String?  @unique @map("conversation_id") // Created upon acceptance
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  senderOrg    Organization  @relation("SentPanelRequests", fields: [senderOrgId], references: [id], onDelete: Cascade)
  receiverOrg  Organization  @relation("ReceivedPanelRequests", fields: [receiverOrgId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@unique([senderOrgId, receiverOrgId]) // Only one request per pair
  @@index([receiverOrgId, status])
  @@map("inter_panel_requests")
}

/// A voice or video call between two users (1-on-1).
model Call {
  id             String    @id @default(uuid())
  callerId       String    @map("caller_id")
  calleeId       String    @map("callee_id")
  conversationId String?   @map("conversation_id")
  type           String    @default("audio") // "audio" | "video"
  status         String    @default("RINGING") // "RINGING" | "ACTIVE" | "ENDED" | "MISSED" | "REJECTED" | "BUSY"
  startedAt      DateTime? @map("started_at")  // When call was answered
  endedAt        DateTime? @map("ended_at")    // When call ended
  duration       Int?      // Duration in seconds
  createdAt      DateTime  @default(now()) @map("created_at")

  caller       User          @relation("CallsMade", fields: [callerId], references: [id], onDelete: Cascade)
  callee       User          @relation("CallsReceived", fields: [calleeId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([callerId, createdAt])
  @@index([calleeId, createdAt])
  @@index([conversationId])
  @@map("calls")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
  @@map("push_subscriptions")
}

// ============================================
// AI AGENT MARKETPLACE
// ============================================

// Global catalog of available AI agents
model Agent {
  id          String   @id @default(uuid())
  slug        String   @unique                // e.g. "transguy", "linda", "guardian"
  name        String                          // Display name
  role        String                          // e.g. "Real-Time Translator"
  tagline     String?                         // Short marketing tagline
  description String                          // Full description / bio
  category    String   @default("productivity") // productivity | communication | analysis | security | creativity
  capabilities String[]                       // Array of capability strings
  avatarUrl   String?  @map("avatar_url")     // Agent profile picture
  gradientFrom String? @map("gradient_from")  // CSS gradient start color
  gradientTo   String? @map("gradient_to")    // CSS gradient end color
  iconName     String? @map("icon_name")      // Lucide icon name fallback
  pricing      String  @default("free")       // free | subscription | per-use
  priceAmount  Float?  @map("price_amount")   // Monthly price if applicable
  isBuiltIn    Boolean @default(false) @map("is_built_in") // System agents like Linda
  isMandatory  Boolean @default(false) @map("is_mandatory") // Can't be fired (e.g. Linda)
  isPopular    Boolean @default(false) @map("is_popular")
  isActive     Boolean @default(true)  @map("is_active")   // Available in marketplace
  sortOrder    Int     @default(0)     @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  orgAgents    OrgAgent[]

  @@index([category])
  @@index([isActive, sortOrder])
  @@map("agents")
}

// Per-organization hired agents
model OrgAgent {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  agentId        String   @map("agent_id")
  isEnabled      Boolean  @default(true)  @map("is_enabled")
  settings       Json?                     // Agent-specific tuning (responsiveness, creativity, etc.)
  hiredAt        DateTime @default(now()) @map("hired_at")
  hiredBy        String?  @map("hired_by") // userId who hired the agent

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([organizationId, agentId])
  @@index([organizationId])
  @@map("org_agents")
}

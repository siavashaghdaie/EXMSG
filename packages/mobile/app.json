{
  "expo": {
    "name": "OmniLink Messenger",
    "slug": "omnilink-messenger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "omnilink",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#7C3AED"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.theomnilink.messenger",
      "infoPlist": {
        "NSCameraUsageDescription": "OmniLink needs camera access for video calls and sharing photos",
        "NSMicrophoneUsageDescription": "OmniLink needs microphone access for voice messages and calls",
        "NSPhotoLibraryUsageDescription": "OmniLink needs photo library access to share images"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#7C3AED"
      },
      "package": "io.theomnilink.messenger",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-image-picker",
      "expo-document-picker",
      "expo-camera",
      "expo-av",
      "expo-haptics",
      "expo-file-system",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7C3AED"
        }
      ]
    ]
  }
}

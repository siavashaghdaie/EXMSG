# =============================================================
# OmniLink Messenger — Production Environment Variables
# =============================================================
# Copy this file to .env in the docker/ directory:
#   cp .env.production.template .env
# Then fill in all values marked with CHANGE_ME
# =============================================================

# --- Domain ---
DOMAIN=theomnilink.io
CORS_ORIGIN=https://theomnilink.io

# --- Database ---
DB_USER=omnilink
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_NAME=omnilink_messenger

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# --- JWT Secrets (generate with: openssl rand -base64 48) ---
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET

# --- Anthropic Claude API (for Linda AI assistant) ---
ANTHROPIC_API_KEY=CHANGE_ME_OR_LEAVE_EMPTY

# --- SerpAPI (for Linda web search) ---
SERPAPI_API_KEY=CHANGE_ME_OR_LEAVE_EMPTY

# --- OpenAI API (for voice transcription via Whisper + TTS for Linda voice replies) ---
OPENAI_API_KEY=CHANGE_ME_OR_LEAVE_EMPTY

# --- Resend Email API ---
RESEND_API_KEY=CHANGE_ME_OR_LEAVE_EMPTY
EMAIL_FROM=linda@theomnilink.io

# --- S3 / MinIO (file uploads) ---
S3_ENDPOINT=https://CHANGE_ME.digitaloceanspaces.com
S3_BUCKET=omnilink-uploads
S3_ACCESS_KEY=CHANGE_ME_S3_KEY
S3_SECRET_KEY=CHANGE_ME_S3_SECRET
S3_REGION=nyc3

# --- SSL (Let's Encrypt) ---
CERTBOT_EMAIL=CHANGE_ME_YOUR_EMAIL@example.com

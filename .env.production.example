# Production Environment Configuration
# Copy this file to .env.production and fill in your actual values

# Node Environment
NODE_ENV=production

# Database Configuration
DB_USER=em_prod_user
DB_PASSWORD=generate-a-strong-password-here
DB_NAME=exclusive_messenger_prod
DATABASE_URL=postgresql://em_prod_user:generate-a-strong-password-here@postgres:5432/exclusive_messenger_prod

# Redis Configuration
REDIS_PASSWORD=generate-a-strong-redis-password-here
REDIS_URL=redis://:generate-a-strong-redis-password-here@redis:6379

# Backend Server Configuration
PORT=3001

# JWT Configuration
JWT_SECRET=generate-a-very-long-random-secret-key-here-min-32-characters
JWT_REFRESH_SECRET=generate-another-very-long-random-secret-key-here-min-32-characters

# CORS Configuration
CORS_ORIGIN=https://yourdomain.com

# S3/DigitalOcean Spaces Configuration (for file storage)
# For DigitalOcean Spaces:
# - S3_ENDPOINT: https://{region}.digitaloceanspaces.com
# - S3_BUCKET: your-space-name
# - S3_ACCESS_KEY: your-access-key
# - S3_SECRET_KEY: your-secret-key
#
# For AWS S3:
# - S3_ENDPOINT: https://s3.amazonaws.com (or your region-specific endpoint)
# - S3_BUCKET: your-bucket-name
# - S3_ACCESS_KEY: your-access-key
# - S3_SECRET_KEY: your-secret-key

S3_ENDPOINT=https://{region}.digitaloceanspaces.com
S3_BUCKET=your-space-name
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# Optional: Email Configuration (if your backend supports it)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-email-password
# SMTP_FROM=noreply@yourdomain.com

# Optional: Logging Configuration
# LOG_LEVEL=info
# LOG_FORMAT=json
